# ==============================================================================
# Convex Environment Variables
# ==============================================================================
# These variables must be set in the Convex Dashboard:
# https://dashboard.convex.dev → Your Project → Settings → Environment Variables
#
# DO NOT put these in a local .env file - they are server-side secrets!

# ------------------------------------------------------------------------------
# Clerk Configuration (Required)
# Get your JWT issuer domain from: https://dashboard.clerk.com
# Format: https://your-instance.clerk.accounts.dev
# ------------------------------------------------------------------------------
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# ------------------------------------------------------------------------------
# Super Admin Configuration (Required for admin dashboard)
# Comma-separated list of email addresses with super admin access
# ------------------------------------------------------------------------------
# Single admin:
SUPER_ADMIN_EMAILS=admin@example.com
# Multiple admins (comma-separated, no spaces):
# SUPER_ADMIN_EMAILS=admin@example.com,owner@example.com,dev@example.com

# ------------------------------------------------------------------------------
# Stripe Configuration (Required for Premium features)
# Get your keys from: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------

# App URL used to validate Stripe redirect URLs
# Must exactly match your frontend origin (including protocol and port if any)
# Examples:
#   Production: https://timesync.app
#   Local dev:  http://localhost:3000
APP_URL=https://timesync.app

# Secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret (starts with whsec_)
# Create webhook at: Stripe Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://<your-convex-deployment>.convex.site/stripe-webhook
# Events to listen for:
#   - checkout.session.completed
#   - checkout.session.expired
#   - customer.subscription.updated
#   - customer.subscription.deleted
#   - invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID for the Premium subscription (starts with price_)
# Create product at: Stripe Dashboard → Products → Add Product
# Recommended: "TimeSync Premium" at $5/month recurring
STRIPE_PRICE_ID=price_...

# ------------------------------------------------------------------------------
# lame-mail Configuration (Required for transactional email)
# lame-mail is a self-hosted email service (AWS API Gateway + Lambda + SES).
# Powers the "here are your event links" email sent on event creation and the
# "new response" notification. If these are unset, all email is silently
# skipped (the app still works, it just won't send mail).
#
# The `timesync` project (sender + branding) is configured inside lame-mail;
# this app only needs the API base URL and its project-scoped API key. Retrieve
# the key from AWS API Gateway (see lame-mail's docs/INTEGRATION.md).
# Note: APP_URL (above) is used to build the links inside emails.
# ------------------------------------------------------------------------------

# API base URL (API Gateway stage URL)
LAME_MAIL_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod

# Project-scoped API key (sent as the x-api-key header)
LAME_MAIL_API_KEY=your-lame-mail-api-key
