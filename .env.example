# ==============================================================================
# Local Environment Variables (.env.local)
# ==============================================================================
# Copy this file to .env.local and fill in your values
# These variables are used by the frontend (Vite)

# ------------------------------------------------------------------------------
# Convex Configuration (Required)
# Get your deployment URL from: https://dashboard.convex.dev
# ------------------------------------------------------------------------------
VITE_CONVEX_URL=https://your-project.convex.cloud

# ------------------------------------------------------------------------------
# Clerk Configuration (Required)
# Get your publishable key from: https://dashboard.clerk.com
# ------------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# Stripe Configuration (Optional - for Premium features)
# Get your publishable key from: https://dashboard.stripe.com/apikeys
# Note: The secret key goes in Convex, not here (see .env.convex.example)
# ------------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# Umami Analytics (Optional)
# Get these from your Umami instance settings
# ------------------------------------------------------------------------------
# VITE_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js
# VITE_UMAMI_WEBSITE_ID=your-website-id

# ------------------------------------------------------------------------------
# PostHog Analytics (Optional)
# Custom events + funnels. Umami (above) still owns pageviews - do not set
# these up to double-track pageviews.
# Get these from your PostHog project settings: https://us.posthog.com
# ------------------------------------------------------------------------------
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# CI/CD Configuration (Optional)
# Only needed for automated deployments
# Get your deploy key from: Convex Dashboard → Settings → Deploy Key
# ------------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=prod:your-deploy-key
